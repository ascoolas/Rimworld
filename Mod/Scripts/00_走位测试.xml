<?xml version="1.0" encoding="utf-8"?>
<!--
  走位测试剧本：第一次装好 Mod 时用它来检查一切正常。

  准备：
  1. 开一局新游戏（地图大小选 250×250），把两个殖民者改名为“巴尔塔萨”和“布里蒙达”
     （点角色 → 角色信息卡片左上角的铅笔图标，改“昵称”即可）。
  2. 地图中央 (125,125) 附近留一块空地。如果那里有树或石头，
     把下面的坐标改成别的空地（把鼠标放到地上，鼠标旁边会显示坐标）。

  每一行的格式：<指令 秒="第几秒执行" 其它属性="..."/>
  1 秒 = 游戏 1 倍速下的 1 秒。
-->
<剧本 名称="走位测试">

  <注释 内容="开场：远景，天气晴，下午三点"/>
  <天气 秒="0" 类型="晴"/>
  <时刻 秒="0" 小时="15"/>
  <镜头 秒="0" 对准="125,125" 缩放="大全景"/>

  <!-- 两人从两侧走向中间 -->
  <走 秒="1" 角色="布里蒙达" 到="122,125" 步态="慢走" 面向="东"/>
  <走 秒="2" 角色="巴尔塔萨" 到="128,125" 步态="慢走" 面向="西"/>

  <!-- 镜头 4 秒内慢慢推近 -->
  <镜头 秒="3" 对准="125,125" 缩放="近景" 用时="4"/>

  <!-- 巴尔塔萨走到布里蒙达身边，会自动面向她 -->
  <走 秒="12" 角色="巴尔塔萨" 到="布里蒙达" 步态="慢走"/>
  <面向 秒="12" 角色="布里蒙达" 目标="巴尔塔萨"/>

  <!-- 镜头跟随布里蒙达，她离开 -->
  <跟随 秒="18" 角色="布里蒙达" 缩放="中景" 用时="2"/>
  <走 秒="19" 角色="布里蒙达" 到="125,140" 步态="慢走"/>
  <面向 秒="19" 角色="巴尔塔萨" 目标="布里蒙达"/>

  <停止跟随 秒="30"/>
  <天气 秒="30" 类型="雨" 渐变="是"/>
  <结束 秒="34"/>

</剧本>
